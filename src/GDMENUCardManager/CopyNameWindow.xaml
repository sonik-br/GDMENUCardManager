<Window x:Class="GDMENUCardManager.CopyNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GDMENUCardManager"
        xmlns:coreres="clr-namespace:GDMENUCardManager.Core.Resources;assembly=GDMENUCardManager.Core"
        mc:Ignorable="d"
        Title="{x:Static coreres:AppStrings.BatchRename}" Height="270" Width="350"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel>
        <GroupBox Header="{x:Static coreres:AppStrings.RenameAllGamesLocatedOn}" Margin="5">
            <StackPanel>
                <CheckBox Content="{x:Static coreres:AppStrings.SdCard}" IsChecked="{Binding OnCard, Mode=TwoWay}"/>
                <CheckBox Content="{x:Static coreres:AppStrings.Other}" IsChecked="{Binding NotOnCard, Mode=TwoWay}"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="{x:Static coreres:AppStrings.CopyNameFrom}" Margin="5">
            <StackPanel>
                <RadioButton Content="{x:Static coreres:AppStrings.Folder}" IsChecked="{Binding FolderName, Mode=TwoWay}"/>
                <RadioButton Content="{x:Static coreres:AppStrings.File}"/>
            </StackPanel>
        </GroupBox>
        <GroupBox Header="{x:Static coreres:AppStrings.SpecialParsing}" Margin="5">
            <CheckBox Content="{x:Static coreres:AppStrings.ReadTosecNaming}" IsChecked="{Binding ParseTosec, Mode=TwoWay}"/>
        </GroupBox>

        <Button Click="Button_Click" IsDefault="True" Margin="5" Padding="20 10">Ok</Button>

    </StackPanel>
</Window>
